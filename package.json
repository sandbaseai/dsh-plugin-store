{
  "name": "@sandbaseai/dsh-plugin-store",
  "description": "Native plugin marketplace for discovering, filtering, installing, and managing DeepSeek Harness plugins",
  "version": "0.1.0",
  "homepage": "https://github.com/sandbaseai/dsh-plugin-store#readme",
  "bugs": {
    "url": "https://github.com/sandbaseai/dsh-plugin-store/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin-store",
    "plugin-marketplace",
    "agent-harness",
    "ai-agents"
  ],
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandbaseai/dsh-plugin-store.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-web": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^",
    "@sandbaseai/dsh-plugin-shared": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-web": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^"
  }
}
