{
  "name": "@sandbaseai/dsh-plugin-store",
  "description": "Native DeepSeek Harness plugin marketplace for discovering, filtering, installing, and managing community DSH plugins.",
  "version": "0.1.0-preview.6",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin-store",
    "plugin-marketplace",
    "cordis",
    "ai-agent",
    "agent-harness",
    "developer-tools",
    "sandbase"
  ],
  "author": "SandbaseAI",
  "homepage": "https://github.com/sandbaseai/dsh-plugin-store#readme",
  "bugs": {
    "url": "https://github.com/sandbaseai/dsh-plugin-store/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandbaseai/dsh-plugin-store.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc && npm run bundle",
    "test": "vitest run"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-host-webserver": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-web": "^0.2.1-rc.5",
    "@deepseek-ai/schemastery": "~3.18.5",
    "react": "^18.2.0 || ^19.0.0",
    "@deepseek-ai/dsh-plugin-manager": "^0.2.1-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.5",
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-web": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "react": "^18.2.0",
    "@types/react": "~18.3.1",
    "@types/node": "^22.19.0",
    "typescript": "~5.9.3",
    "esbuild": "^0.25.12",
    "lightningcss": "^1.30.2",
    "vitest": "^3.2.4",
    "@deepseek-ai/dsh-plugin-manager": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
